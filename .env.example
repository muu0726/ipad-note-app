# Supabase 接続情報テンプレート（外部脳ノートアプリ）
# 使い方: `cp .env.example .env` して実値を埋める。.env は Git にコミットしない。
# 値は Supabase ダッシュボード → Settings → API から取得。詳細は supabase/README.md。

# --- クライアント公開可（RLS 前提） / iPad・Web で使用 ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- サーバー専用・RLS を貫通する強権限 / MCP(#26) 専用。クライアントや Git に置かない ---
# SUPABASE_SERVICE_ROLE_KEY=


# --- Web (Next.js) 用エイリアス。web/.env.local に置く（#11）---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
